# Copy this file to .env and add your SMTP details.
# Gmail example: use an App Password, NOT your normal Gmail password.

PORT=5000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=yourgmail@gmail.com

# The inbox where website inquiries should arrive
NOTIFY_EMAIL=muhammadmudasir5223@gmail.com
